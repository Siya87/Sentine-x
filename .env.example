# SentinelX AI - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# MongoDB Configuration
# ============================================
# Get from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sentinelx?retryWrites=true&w=majority

# ============================================
# IBM Watsonx AI Configuration
# ============================================
# Get from IBM Cloud: https://cloud.ibm.com/
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ============================================
# Security & Threat Intelligence APIs
# ============================================
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Shodan: https://account.shodan.io/
SHODAN_API_KEY=your_shodan_api_key_here

# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Have I Been Pwned: https://haveibeenpwned.com/API/Key
HAVEIBEENPWNED_API_KEY=your_haveibeenpwned_api_key_here

# ============================================
# Application Configuration
# ============================================
DEBUG=false
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com

# Optional: Secret key for JWT tokens
SECRET_KEY=your-secret-key-for-jwt-tokens

# ============================================
# Frontend Configuration
# ============================================
REACT_APP_API_URL=http://localhost:8000

# ============================================
# Optional: Email Configuration (for notifications)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@sentinelx.ai

# ============================================
# Optional: Redis (for caching)
# ============================================
# REDIS_URL=redis://localhost:6379/0

# ============================================
# Optional: Sentry (for error tracking)
# ============================================
# SENTRY_DSN=your-sentry-dsn-here

# ============================================
# Notes:
# ============================================
# 1. Never commit .env file to version control
# 2. Keep API keys secure and rotate them regularly
# 3. Use different keys for development and production
# 4. Set DEBUG=false in production
# 5. Update CORS_ORIGINS with your actual frontend domain